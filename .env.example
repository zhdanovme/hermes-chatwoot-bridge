# Chatwoot local instance
CHATWOOT_SECRET_KEY_BASE=local-only-change-me
CHATWOOT_API_TOKEN=replace-with-chatwoot-user-api-token
CHATWOOT_WEBHOOK_SECRET=

# Hermes API server and provider
HERMES_API_KEY=local-hermes-api-key
# Set at least one provider key or run `docker compose exec hermes hermes setup --portal`.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://ai-gateway.void0.org/v1
ANTHROPIC_API_KEY=

# Chatwoot Website inbox token (shown in Settings → Inboxes → Website)
CHATWOOT_PUBLIC_URL=http://localhost:3000
CHATWOOT_WEBSITE_TOKEN=

# Optional bridge tuning
HERMES_MODEL=hermes-agent
WEBHOOK_TOLERANCE_SECONDS=300
